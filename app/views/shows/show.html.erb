<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Select Seats</title>
</head>
<body>
    <main data-controller="seat-selection" data-seat-selection-show-id-value="<%= @show.id %>">
        <h1>Select Your Seats</h1>
        <p><strong>Screen:</strong> <%= @show.screen.name %> | <strong>Price:</strong> $<%= @show.ticket_price %></p>
        
        <div style="text-align: center; margin: 20px 0; background: #ccc; padding: 5px;">
            <strong>SCREEN THIS WAY</strong>
        </div>

        <h3>Seating Layout</h3>
        <%= form_with url: create_multiple_seat_locks_path, method: :post, local: true do |f| %>
            <%= f.hidden_field :show_id, value: @show.id %>

            <div style="display: grid; grid-template-columns: repeat(10, 1fr); gap: 10px; margin-bottom: 30px;">
                <% @show.screen.seats.order(:row_name, :seat_number).each do |seat| %>
                    <% is_locked = @show.seat_locks.active.exists?(seat_id: seat.id) %>
                    <% is_booked = @show.booking_seats.exists?(seat_id: seat.id) %>

                    <fieldset id="seat_<%= seat.id %>" 
                              data-row="<%= seat.row_name %>" 
                              data-number="<%= seat.seat_number %>"
                              style="text-align: center; padding: 5px; <%= 'background: #ffcccc;' if is_booked || is_locked %>">
                        <small><%= seat.row_name %><%= seat.seat_number %></small><br>
                        
                        <% if is_booked %>
                            <span style="color: red; font-size: 11px;">Booked</span>
                        <% elsif is_locked %>
                            <span style="color: orange; font-size: 11px;">Locked</span>
                        <% else %>
                            <%= check_box_tag "seat_ids[]", seat.id, false, id: "check_seat_#{seat.id}" %>
                        <% end %>
                    </fieldset>
                <% end %>
            </div>

            <div style="text-align: center; margin-bottom: 30px;">
                <%= f.submit "Hold Selected Seats for 5 Mins", style: "padding: 10px 20px; background: #ff9900; font-weight: bold; cursor: pointer;" %>
            </div>
        <% end %>

        <hr>
        </main>
</body>
</html>